# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking
MIGRATE_ON_START=true
# at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_PER_MINUTE=120
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
